# connect-src below intentionally allows `https:` and http://localhost / 127.0.0.1
# so a user-configured Custom (OpenAI-compatible) AI endpoint — e.g. a self-hosted
# llama.cpp server — is reachable from the browser. The same `https:` allowance also
# backs the "Import from URL…" feature (fetching a remote .json/.stl/.step/.svg/.vox/
# image over https), so the browser-side fetch isn't blocked by CSP. The named hosts
# that follow are the first-party cloud APIs + model CDN; they're subsumed by `https:`
# but kept as documentation of expected traffic. Plain-HTTP LAN addresses still won't
# load on the hosted HTTPS site (browser mixed-content rule) — only HTTPS or localhost.
#
# `script-src` additionally allows https://static.cloudflareinsights.com so the
# privacy-first Cloudflare Web Analytics beacon (cookieless, aggregate-only — see
# /legal) can load; its `cdn-cgi/rum` POST is already covered by the broad `https:`
# in `connect-src`. Drop the host here if Web Analytics is ever turned off.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://huggingface.co https://*.huggingface.co https://*.xethub.hf.co https://raw.githubusercontent.com; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# Catalog thumbnails carry a content hash in their filename, so they're safe to
# cache forever — a changed image gets a new name. Immutable = no revalidation
# on refresh; only a new build (new hash) busts it.
/catalog/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

/*.md
  Content-Type: text/markdown; charset=utf-8

/*.txt
  Content-Type: text/plain; charset=utf-8

# Engine sandbox frame (docs/engine-sandbox.md, kemper/partwright#1090). With the
# sandbox enabled, the geometry Worker that evaluates model code lives in this
# hidden iframe on a different origin. The document gets a SECOND, much tighter
# CSP: browsers enforce every policy they receive (the effective policy is the
# intersection with the `/*` one above), so the Worker it spawns — a blob:
# Worker, which inherits this document's policy — can only connect to 'self':
# no `https:`, no AI-provider hosts. CORP cross-origin lets a COEP:require-corp
# app on ANOTHER origin embed it ('origin' mode). Keep the CSP in sync with
# SANDBOX_CSP in vite.config.ts. Cloudflare serves the built sandbox.html at
# its clean URL, so list both spellings, under each version mount.
/sandbox
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

/sandbox.html
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

/v1/sandbox
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

/v1/sandbox.html
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

# Engine sandbox 'opaque' mode: the frame (and its Worker) has an opaque origin,
# so every engine module / wasm / font / BOSL2 file it loads from this site is a
# cross-origin request from `Origin: null` and needs CORS. These are public,
# credential-free static assets.
/assets/*
  Access-Control-Allow-Origin: *

/openscad-libs/*
  Access-Control-Allow-Origin: *

/v1/assets/*
  Access-Control-Allow-Origin: *

/v1/openscad-libs/*
  Access-Control-Allow-Origin: *
